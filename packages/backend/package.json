{
  "name": "@nasktv/backend",
  "version": "0.3.11",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit --rootDir ../..",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx -e \"import { runMigrations } from './src/db/migrate'; runMigrations(); console.log('Done'); process.exit(0);\"",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@nasktv/shared": "workspace:*",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.0.0",
    "chardet": "^2.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "drizzle-orm": "^0.36.0",
    "express": "^4.18.2",
    "fast-glob": "^3.3.2",
    "helmet": "^7.1.0",
    "iconv-lite": "^0.6.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "music-metadata": "^10.6.3",
    "openai": "^4.50.0",
    "pino": "^8.16.0",
    "pino-pretty": "^10.2.3",
    "pinyin-pro": "^3.25.0",
    "qrcode": "^1.5.4",
    "tsx": "^4.6.2",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.8",
    "@types/cors": "^2.8.15",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.2.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.10",
    "drizzle-kit": "^0.27.0",
    "typescript": "^5.3.2"
  }
}
