{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NASKTV",
  "version": "0.4.0",
  "identifier": "com.nasktv.tvapp",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "fullscreen": false,
        "height": 720,
        "resizable": true,
        "title": "NASKTV",
        "width": 1280
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "category": "Entertainment",
    "copyright": "",
    "shortDescription": "NASKTV Player",
    "longDescription": "NASKTV KTV Player for Android TV",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
