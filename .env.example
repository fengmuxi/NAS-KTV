# ============================================================
# NASKTV 环境变量模板
# 复制此文件为 .env 并根据实际情况修改
# cp .env.example .env
# ============================================================

# ==================== 后端 (backend) ====================

# 服务端口
PORT=3000

# 运行环境：development | production
NODE_ENV=development

# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# H5 点歌会话有效期（分钟）。到期后必须重新输入房间码加入，默认 4 小时。
H5_SESSION_TTL_MINUTES=240

# TV 动态二维码/加入码有效期（分钟）。刷新后旧票据立即失效，默认 5 分钟。
H5_JOIN_TICKET_TTL_MINUTES=5

# JWT 密钥（生产环境务必修改）
JWT_SECRET=your-jwt-secret-change-me

# 数据库文件路径（相对于项目根目录；Docker 中使用绝对路径 /app/data/db/nasktv.db）
DB_PATH=./data/db.sqlite

# 管理员账号（首次启动时自动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 歌曲扫描目录（本地开发指向宿主机路径；Docker 中使用 /app/data/songs）
SCAN_PATH=./data/songs

# ==================== 人声分离 (separator) ====================

# separator 服务地址（本地开发用 localhost，Docker 部署用容器名 http://separator:8001）
SEPARATOR_SERVICE_URL=http://localhost:8001

# 分离结果输出目录（本地开发用相对路径；Docker 中使用 /app/data/separation）
SEPARATION_OUTPUT_DIR=./data/separation

# PyTorch 安装源（GPU 版 CUDA 12.4 轮子；国内可改用阿里云镜像：
# https://mirrors.aliyun.com/pytorch-wheels/cu124/）
# PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cu124

# 分离并发数（未在管理后台设置时生效）
SEPARATION_CONCURRENCY=2

# PyTorch/Demucs 由 separator 服务启动后在后台自动安装（不阻塞启动），
# 也支持将离线 .whl 安装包放入该目录由服务后台离线安装（默认项目根 data/separator-install）。
# SEPARATOR_INSTALL_DIR=./data/separator-install

# 扫描后自动启用人声分离：true | false
SEPARATION_AUTO_ENABLE=true

# ffmpeg / ffprobe 可执行文件路径（留空则从 PATH 查找）
# 可指向完整路径：C:\ffmpeg\bin\ffmpeg.exe
# 可指向目录：    C:\ffmpeg\bin
# Docker 中 ffmpeg 已内置，无需设置
FFMPEG_PATH=

# HuggingFace 镜像源（国内加速模型下载）
# 留空使用官方源（可能超时），推荐设置为：
# https://hf-mirror.com
HF_ENDPOINT=

# ==================== AI 解析 ====================

# AI 功能总开关：true | false
AI_ENABLED=false

# OpenAI 兼容接口地址
AI_BASE_URL=https://api.openai.com/v1

# API 密钥
AI_API_KEY=

# 模型名称
AI_MODEL=gpt-4o-mini

# 扫描后自动 AI 解析歌曲元数据：true | false
AI_AUTO_PARSE_AFTER_SCAN=true

# AI 解析并发数（未在管理后台设置时生效）
AI_PARSE_CONCURRENCY=2
