{
  "name": "nasktv",
  "private": true,
  "version": "0.4.0",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "start /B node scripts/dev-proxy.js & pnpm -r --parallel run dev",
    "dev-proxy": "node scripts/dev-proxy.js",
    "kill-ports": "node scripts/kill-ports.js",
    "version:sync": "node scripts/set-version.mjs",
    "predev": "node scripts/kill-ports.js && node scripts/set-version.mjs",
    "prebuild": "node scripts/set-version.mjs",
    "lint": "pnpm -r run lint",
    "clean": "pnpm -r run clean"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.0.0",
  "volta": {
    "node": "20.10.0"
  }
}
